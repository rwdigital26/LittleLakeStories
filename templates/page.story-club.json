    "story_club_faq": {
      "type": "story-club-faq",
      "blocks": {
        "how_it_works": {
          "type": "question",
          "settings": {
            "question": "How does the Story Club work?",
            "answer": "Complete your child’s profile once and we’ll curate a new personalized story for them each month, including a special story for their birthday month."
          }
        },
        "what_is_included": {
          "type": "question",
          "settings": {
            "question": "What is included in each book?",
            "answer": "Each book features your child’s name, appearance, and favorite details, brought to life in a seasonal adventure."
          }
        },
        "introductory_pricing": {
          "type": "question",
          "settings": {
            "question": "How does the introductory pricing work?",
            "answer": "The 3-month plan is $59.85 total, or $19.95 per book. Longer gift plans offer lower per-book pricing."
          }
        },
        "gift_membership": {
          "type": "question",
          "settings": {
            "question": "Can I give a gift membership?",
            "answer": "Yes. Choose a 3-, 6-, or 12-month gift plan above. Gift memberships are paid once and do not automatically renew."
          }
        },
        "cancellation": {
          "type": "question",
          "settings": {
            "question": "Can I cancel anytime?",
            "answer": "Gift memberships are one-time purchases and do not automatically renew. For recurring membership cancellation details, please contact us."
          }
        },
        "ages": {
          "type": "question",
          "settings": {
            "question": "What ages are the books best for?",
            "answer": "Story Club books are made for children and are a lovely fit for family storytime. Stories are curated around your child’s age and interests."
          }
        },
        "multiple_children": {
          "type": "question",
          "settings": {
            "question": "Can I have more than one child?",
            "answer": "Each membership is set up around a child’s profile. Contact us and we’ll help you choose the right option for siblings."
          }
        },
        "birthday_story": {
          "type": "question",
          "settings": {
            "question": "How is the birthday story handled?",
            "answer": "Add your child’s birthday to their profile and we’ll include a special personalized story during their birthday month."
          }
        },
        "first_shipment": {
          "type": "question",
          "settings": {
            "question": "When will my first book ship?",
            "answer": "Your first book enters curation after checkout and profile completion. We’ll email you when it ships."
          }
        },
        "international_shipping": {
          "type": "question",
          "settings": {
            "question": "Do you ship outside the US?",
            "answer": "Shipping is included on these Story Club plans. Contact us before ordering to check international availability."
          }
        }
      },
