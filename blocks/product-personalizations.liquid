{% liquid
  assign current_product = closest.product
  assign show_customizations = false
  assign is_custom_book = false
  assign has_subscription_variants = true
  if current_product != blank
    if current_product.tags contains 'Subscription'
      assign membership_option = current_product.options_by_name['Membership Length']
      if membership_option == blank
        assign has_subscription_variants = false
      elsif membership_option.values.size < 2
        assign has_subscription_variants = false
      endif
    endif
    unless current_product.tags contains 'Hard Cover Upgrade' or current_product.tags contains 'Cart Upsell'
      assign show_customizations = true
      if current_product.tags contains 'Custom'
        assign is_custom_book = true
      endif
    endunless
  endif

  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign component_id = 'ProductPersonalizations-' | append: current_product.id | append: '-' | append: block.id
  assign book_cover = current_product.featured_media.preview_image | default: current_product.featured_image
%}

{% if show_customizations %}
  <product-personalization-component
    class="product-personalization"
    id="{{ component_id }}"
    data-product-personalization
    data-product-id="{{ current_product.id }}"
    data-product-form-id="{{ product_form_id }}"
    data-hardcover-addon-variant-id="67672769036542"
    {{ block.shopify_attributes }}
  >
    <button
      class="product-personalization__trigger button"
      type="button"
      data-open-customizer
      {% unless current_product.available and has_subscription_variants %}disabled{% endunless %}
    >
      {% if is_custom_book %}Create Their Custom Story{% else %}Personalize This Book{% endif %}
    </button>

    {% if current_product.tags contains 'Subscription' %}
      <div class="subscription-product-benefits" aria-label="Membership benefits">
        <span>
          <img src="https://cdn.shopify.com/s/files/1/0831/8376/3710/files/shipping.png" alt="" width="24" height="24" loading="eager">
          Free shipping included
        </span>
        <span>
          <img src="https://cdn.shopify.com/s/files/1/0831/8376/3710/files/book.png" alt="" width="24" height="24" loading="eager">
          One-of-a-kind stories
        </span>
        <span>
          <img src="https://cdn.shopify.com/s/files/1/0831/8376/3710/files/gift.png" alt="" width="24" height="24" loading="eager">
          A meaningful gift
        </span>
      </div>
    {% endif %}

    <dialog
      class="product-personalization__dialog"
      data-wizard-dialog
      aria-labelledby="{{ component_id }}-title"
    >
      <div class="product-personalization__modal">
        <header class="product-personalization__modal-header">
          <h2 id="{{ component_id }}-title">Customize This Book</h2>
          <button class="product-personalization__close" type="button" data-close-customizer aria-label="Close customization">
            <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
          </button>
        </header>

        <div class="product-personalization__modal-body">
          <aside class="product-personalization__preview" aria-label="Character preview">
            <img data-hair-preview alt="" width="500" height="500" hidden>
            {% if book_cover != blank %}
              <img
                class="product-personalization__book-cover-preview"
                data-book-cover-preview
                src="{{ book_cover | image_url: width: 800 }}"
                alt="{{ current_product.title | escape }} cover"
                width="500"
                height="500"
                hidden
              >
            {% endif %}
            <p data-hair-preview-placeholder>Choose a character style to preview it here.</p>
          </aside>

          <div class="product-personalization__wizard">
            <p class="product-personalization__step-indicator" aria-live="polite" data-step-indicator>Step 1 of 4</p>

            <section class="product-personalization__step" data-wizard-step="1" aria-labelledby="{{ component_id }}-step-1-title">
              <h3 id="{{ component_id }}-step-1-title">Meet the star</h3>
              <fieldset class="product-personalization__group">
                <legend>Gender</legend>
                <div class="product-personalization__gender-options">
                  {% assign gender_options = 'Girl|Boy' | split: '|' %}
                  {% for gender_option in gender_options %}
                    <label class="product-personalization__gender-option">
                      <input
                        type="radio"
                        name="properties[Gender]"
                        value="{{ gender_option }}"
                        form="{{ product_form_id }}"
                        data-gender-option
                        {% if forloop.first %}required checked{% endif %}
                      >
                      <span>{{ gender_option }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>

              <div class="product-personalization__field">
                <label for="{{ component_id }}-first-name">First Name</label>
                <input
                  id="{{ component_id }}-first-name"
                  type="text"
                  name="properties[Child's First Name]"
                  form="{{ product_form_id }}"
                  autocomplete="given-name"
                  maxlength="40"
                  required
                >
              </div>

              <div class="product-personalization__field">
                <label for="{{ component_id }}-skin-tone">Skin Tone</label>
                <input
                  id="{{ component_id }}-skin-tone"
                  class="product-personalization__range product-personalization__range--skin"
                  type="range"
                  min="0"
                  max="6"
                  step="1"
                  value="3"
                  aria-describedby="{{ component_id }}-skin-value"
                  data-range-values="Very light|Light|Light-medium|Medium|Medium-deep|Deep|Very deep"
                  data-range-colors="#f6dfcf|#edc6aa|#d8a27f|#bd805d|#986044|#74472f|#4d3024"
                  data-personalization-range
                >
                <input type="hidden" name="properties[Skin Tone]" value="Medium" form="{{ product_form_id }}" data-range-property>
                <output id="{{ component_id }}-skin-value" class="product-personalization__value" data-range-output>Medium</output>
              </div>
            </section>

            <section class="product-personalization__step" data-wizard-step="2" aria-labelledby="{{ component_id }}-step-2-title" hidden>
              <h3 id="{{ component_id }}-step-2-title">Choose their features</h3>
              <div class="product-personalization__field">
                <label for="{{ component_id }}-hair-style">Hair Style</label>
                <div class="product-personalization__style-carousel">
                  <button class="product-personalization__carousel-button" type="button" data-style-previous aria-label="Previous hair style">
                    <span class="svg-wrapper">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
                  </button>
                  <div class="product-personalization__style-options" role="group" aria-label="Choose a hair style">
                    {% assign hairstyle_options = 'Curly coils|Tight curls|Bob|Pigtails|Afro|Twists|Braids|Long straight|Wavy|Two braids|Buzz cut|Side braid|Straight|Shoulder length|Bun|Short cropped|Long hair|Shoulder length|Ponytail|No hair' | split: '|' %}
                    {% assign hairstyle_sources = 'Curly2|Coily_tight_curls|Bob|Pigtails|Afro|Twists|Braids2|Long|Wavy|Two_Briads|Buzz_Cut|Braid|Straightpng|Shoulder_Length|Bun|Short_Cropped|https://cdn.shopify.com/s/files/1/0831/8376/3710/files/Boy_Long_Hair.png?v=1791316721|https://cdn.shopify.com/s/files/1/0831/8376/3710/files/Boy_Shoulder_Length.png?v=1791316720|Ponytail|Bald_No_Hair' | split: '|' %}
                    {% assign hairstyle_genders = 'Girl|Girl|Girl|Girl|Girl|Girl|Girl|Girl|Girl|Girl|Boy|Girl|Girl|Girl|Girl|Boy|Boy|Boy|Girl|Both' | split: '|' %}
                    {% for hairstyle_option in hairstyle_options %}
                      {% assign hairstyle_source = hairstyle_sources[forloop.index0] %}
                      {% assign hairstyle_gender = hairstyle_genders[forloop.index0] %}
                      {% if hairstyle_source contains 'https://' %}
                        {% assign hairstyle_image = hairstyle_source %}
                      {% else %}
                        {% assign hairstyle_image = hairstyle_source | append: '.png' | file_url %}
                      {% endif %}
                      {% assign hairstyle_thumbnail = hairstyle_image | append: '&width=256' %}
                      {% assign hairstyle_preview = hairstyle_image | append: '&width=800' %}
                      <button
                        class="product-personalization__style-option"
                        type="button"
                        data-hair-choice
                        data-hair-gender="{{ hairstyle_gender }}"
                        data-hair-style="{{ hairstyle_option }}"
                        data-hair-image="{{ hairstyle_preview }}"
                        aria-label="{{ hairstyle_option }}"
                        aria-pressed="false"
                        hidden
                      >
                        <img src="{{ hairstyle_thumbnail }}" alt="" width="256" height="256" loading="lazy">
                        <span>{{ hairstyle_option }}</span>
                      </button>
                    {% endfor %}
                  </div>
                  <button class="product-personalization__carousel-button" type="button" data-style-next aria-label="Next hair style">
                    <span class="svg-wrapper">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                  </button>
                </div>
                <input
                  id="{{ component_id }}-hair-style"
                  class="product-personalization__range product-personalization__range--style"
                  type="range"
                  min="0"
                  max="0"
                  step="1"
                  value="0"
                  aria-describedby="{{ component_id }}-hair-style-value"
                  data-personalization-range
                  disabled
                >
                <input type="hidden" name="properties[Hair Style]" value="" form="{{ product_form_id }}" data-range-property>
                <output id="{{ component_id }}-hair-style-value" class="product-personalization__value" data-range-output>Choose Girl or Boy to view styles</output>
              </div>

              <div class="product-personalization__field">
                <label for="{{ component_id }}-hair-color">Hair Color</label>
                <input
                  id="{{ component_id }}-hair-color"
                  class="product-personalization__range product-personalization__range--color"
                  type="range"
                  min="0"
                  max="6"
                  step="1"
                  value="2"
                  aria-describedby="{{ component_id }}-hair-color-value"
                  data-range-values="Blonde|Light brown|Brown|Auburn|Dark brown|Black|Silver"
                  data-range-colors="#e9c878|#a86d3d|#75452d|#a74732|#4b3027|#242020|#b8b9bb"
                  data-personalization-range
                >
                <input type="hidden" name="properties[Hair Color]" value="Brown" form="{{ product_form_id }}" data-range-property>
                <output id="{{ component_id }}-hair-color-value" class="product-personalization__value" data-range-output>Brown</output>
              </div>

              <div class="product-personalization__field">
                <label for="{{ component_id }}-eye-color">Eye Color</label>
                <input
                  id="{{ component_id }}-eye-color"
                  class="product-personalization__range product-personalization__range--eye"
                  type="range"
                  min="0"
                  max="3"
                  step="1"
                  value="0"
                  aria-describedby="{{ component_id }}-eye-color-value"
                  data-range-values="Brown|Blue|Green|Hazel"
                  data-range-colors="#593a2c|#4a83a2|#66804c|#8b7142"
                  data-personalization-range
                >
                <input type="hidden" name="properties[Eye Color]" value="Brown" form="{{ product_form_id }}" data-range-property>
                <output id="{{ component_id }}-eye-color-value" class="product-personalization__value" data-range-output>Brown</output>
              </div>
            </section>

            <section class="product-personalization__step" data-wizard-step="3" aria-labelledby="{{ component_id }}-step-3-title" hidden>
              <h3 id="{{ component_id }}-step-3-title">Add a personal touch</h3>
              <div class="product-personalization__field">
                <label for="{{ component_id }}-giver">Who is giving this book?</label>
                <input
                  id="{{ component_id }}-giver"
                  type="text"
                  name="properties[Book Giver]"
                  form="{{ product_form_id }}"
                  maxlength="100"
                  autocomplete="name"
                >
              </div>
              <div class="product-personalization__field">
                <label for="{{ component_id }}-message">Write your own message</label>
                <textarea
                  id="{{ component_id }}-message"
                  name="properties[Personalized Message]"
                  form="{{ product_form_id }}"
                  maxlength="300"
                  rows="5"
                  aria-describedby="{{ component_id }}-message-count"
                  data-message-input
                ></textarea>
                <p class="product-personalization__character-count" id="{{ component_id }}-message-count" aria-live="polite">
                  <span data-message-count>0</span> / 300 characters
                </p>
              </div>
            </section>

            <section class="product-personalization__step" data-wizard-step="4" aria-labelledby="{{ component_id }}-step-4-title" hidden>
              <h3 id="{{ component_id }}-step-4-title">Upgrade to Hard Cover?</h3>
              <div class="product-personalization__cover-upgrade">
                <span class="product-personalization__cover-price">Just <strong>$9.99</strong> more</span>
                <ul class="product-personalization__cover-benefits">
                  <li><span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>Premium Hard Cover</li>
                  <li><span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>Extra Longevity</li>
                  <li><span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>Perfect Gift Upgrade</li>
                  <li><span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>Perfect Keepsake</li>
                </ul>
                <input
                  type="hidden"
                  name="properties[Cover Type]"
                  value="Soft Cover"
                  form="{{ product_form_id }}"
                  data-cover-property
                >
                <div class="product-personalization__cover-actions">
                  <button
                    class="product-personalization__cover-button product-personalization__cover-button--soft button"
                    type="button"
                    data-cover-choice="Soft Cover"
                  >
                    Keep Soft Cover
                  </button>
                  <button
                    class="product-personalization__cover-button product-personalization__cover-button--hard button"
                    type="button"
                    data-cover-choice="Hard Cover"
                  >
                    <span>YES - Upgrade</span>
                    <span class="product-personalization__cover-button-price">for $9.99 more</span>
                  </button>
                </div>
                <p class="product-personalization__cover-error" role="alert" data-cover-error hidden></p>
              </div>
            </section>

            <div class="product-personalization__navigation">
              <button class="button-secondary" type="button" data-wizard-back hidden>Back</button>
              <button class="button" type="button" data-wizard-next>Next</button>
            </div>
          </div>
        </div>
      </div>
    </dialog>
  </product-personalization-component>

  <script src="{{ 'product-personalization.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}

{% stylesheet %}
  .product-details:has([data-product-personalization]) .product-form-buttons > :not(.product-form-text__error) {
    display: none;
  }

  .product-personalization {
    display: block;
  }

  .subscription-product-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-block: 0 18px;
  }

  .subscription-product-benefits span {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: #486b83;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
  }

  .subscription-product-benefits img {
    display: block;
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .product-personalization__trigger.button {
    --button-background-color: #0b5e97;
    --button-border-color: #0b5e97;
    --button-color: #fff;

    width: 100%;
    min-height: 52px;
    margin-block: var(--padding-lg);
    border-color: #0b5e97;
    background-color: #0b5e97;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-personalization__dialog {
    width: min(880px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 8px;
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 24px 80px rgb(20 61 99 / 24%);
  }

  .product-personalization__dialog::backdrop {
    background: rgb(26 36 43 / 48%);
    backdrop-filter: blur(2px);
  }

  .product-personalization__modal {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    max-height: calc(100dvh - 32px);
  }

  .product-personalization__modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--padding-md);
    padding: var(--padding-md) var(--padding-lg);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 12%);
  }

  .product-personalization__modal-header h2 {
    margin: 0;
    font-size: var(--font-size--xl);
  }

  .product-personalization__close,
  .product-personalization__carousel-button {
    display: grid;
    flex: 0 0 auto;
    width: 40px;
    aspect-ratio: 1;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .product-personalization__close .svg-wrapper,
  .product-personalization__carousel-button .svg-wrapper {
    width: 20px;
    height: 20px;
  }

  .product-personalization__modal-body {
    display: grid;
    grid-template-columns: minmax(200px, 0.85fr) minmax(0, 1.15fr);
    gap: var(--padding-lg);
    min-height: 0;
    padding: var(--padding-lg);
    overflow-y: auto;
  }

  .product-personalization__preview {
    position: sticky;
    top: 0;
    display: grid;
    min-height: 300px;
    place-items: center;
    align-self: start;
    overflow: hidden;
    border-radius: 6px;
    background: #f2f8fa;
  }

  .product-personalization__preview img {
    width: 100%;
    height: 100%;
    max-height: 430px;
    object-fit: contain;
  }

  .product-personalization__preview p {
    max-width: 18ch;
    padding: var(--padding-lg);
    color: #506775;
    text-align: center;
  }

  .product-personalization__book-cover-preview {
    object-fit: contain;
  }

  .product-personalization__wizard {
    min-width: 0;
  }

  .product-personalization__step-indicator {
    margin-block: 0 var(--padding-md);
    color: rgb(var(--color-foreground-rgb) / 65%);
    font-size: var(--font-size--sm);
  }

  .product-personalization__step h3 {
    margin-block: 0 var(--padding-md);
    font-size: var(--font-size--lg);
  }

  .product-personalization__step[hidden] {
    display: none;
  }

  .product-personalization__wizard .product-personalization__field {
    margin-block-end: var(--padding-lg);
  }

  .product-personalization__wizard .product-personalization__field > input:not([type='range']),
  .product-personalization__wizard textarea {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 30%);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .product-personalization__wizard textarea {
    min-height: 130px;
    resize: vertical;
  }

  .product-personalization__character-count {
    margin-block: var(--padding-2xs) 0;
    color: rgb(var(--color-foreground-rgb) / 65%);
    font-size: var(--font-size--sm);
    text-align: end;
  }

  .product-personalization__navigation {
    display: flex;
    justify-content: space-between;
    gap: var(--padding-sm);
    margin-block-start: var(--padding-lg);
  }

  .product-personalization__navigation [hidden] {
    display: none;
  }

  .product-personalization__navigation button {
    min-width: 120px;
    min-height: 48px;
  }

  .product-personalization__navigation [data-wizard-next],
  .product-personalization__navigation [data-wizard-next] {
    margin-inline-start: auto;
  }

  .product-personalization__cover-upgrade {
    position: relative;
  }

  .product-personalization__cover-price {
    display: inline-flex;
    align-items: center;
    gap: var(--padding-2xs);
    margin-block-end: var(--padding-md);
    padding: 8px 14px;
    border-radius: 999px;
    background: #6dc8ec;
    color: #173e52;
    font-size: var(--font-size--sm);
  }

  .product-personalization__cover-price strong {
    font-size: var(--font-size--lg);
  }

  .product-personalization__cover-benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--padding-sm) var(--padding-md);
    margin: 0 0 var(--padding-lg);
    padding: 0;
    list-style: none;
  }

  .product-personalization__cover-benefits li {
    display: flex;
    align-items: center;
    gap: var(--padding-2xs);
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .product-personalization__cover-benefits .svg-wrapper {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    color: #0b5e97;
  }

  .product-personalization__cover-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--padding-sm);
  }

  .product-personalization__cover-error {
    margin-block: var(--padding-sm) 0;
    color: #b4233a;
    font-size: var(--font-size--sm);
  }

  .product-personalization__cover-error[hidden] {
    display: none;
  }

  .product-personalization__cover-button {
    min-height: 48px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-personalization__cover-button--hard {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    line-height: 1.1;
  }

  .product-personalization__cover-button-price {
    font-size: 12px;
    font-weight: 400;
    text-transform: none;
  }

  .product-personalization__cover-button--soft {
    --button-background-color: #bfdeec;
    --button-border-color: #bfdeec;
    --button-color: #203c4b;
  }

  .product-personalization__cover-button--hard {
    --button-background-color: #0b5e97;
    --button-border-color: #0b5e97;
    --button-color: #fff;
  }

  .product-personalization__style-carousel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--padding-2xs);
  }

  .product-personalization__style-options {
    display: flex;
    gap: var(--padding-xs);
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .product-personalization__style-options::-webkit-scrollbar {
    display: none;
  }

  .product-personalization__style-option {
    flex: 0 0 calc((100% - var(--padding-xs) * 2) / 3);
    scroll-snap-align: center;
  }

  .product-personalization__style-option[hidden] {
    display: none;
  }

  .product-personalization__style-option img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .product-personalization__style-option span {
    min-height: 2.2em;
    font-size: 0.72rem;
    line-height: 1.1;
  }

  .product-personalization__style-option.is-selected {
    border-color: #2d86b6;
    box-shadow: inset 0 0 0 1px #2d86b6;
  }

  .product-personalization__group,
  .product-personalization__field {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .product-personalization__group legend,
  .product-personalization__field > label,
  .product-personalization__other-gender > span {
    display: block;
    margin-block-end: var(--padding-sm);
    font: inherit;
    font-weight: 600;
  }

  .product-personalization__gender-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--padding-xs);
  }

  .product-personalization__gender-option {
    position: relative;
    cursor: pointer;
  }

  .product-personalization__gender-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .product-personalization__gender-option span {
    display: block;
    padding: 9px 13px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 25%);
    border-radius: 6px;
    font-size: 0.9em;
  }

  .product-personalization__gender-option:has(input:checked) span {
    border-color: currentColor;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .product-personalization__gender-option:has(input:focus-visible) span,
  .product-personalization__style-option:focus-visible {
    outline: 2px solid #2d86b6;
    outline-offset: 2px;
  }

  .product-personalization__field > input:not([type='range']) {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 30%);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .product-personalization__style-options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--padding-2xs);
    margin-block-end: var(--padding-sm);
  }

  .product-personalization__style-option {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: var(--padding-3xs);
    padding: var(--padding-2xs);
    border: 1px solid rgb(var(--color-foreground-rgb) / 20%);
    border-radius: 6px;
    background: #f4f7f7;
    cursor: pointer;
  }

  .product-personalization__style-option[hidden] {
    display: none;
  }

  .product-personalization__style-option.is-selected {
    border-color: #2d86b6;
    box-shadow: inset 0 0 0 1px #2d86b6;
  }

  .product-personalization__style-option img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .product-personalization__style-option span {
    min-height: 2.2em;
    font-size: 0.72rem;
    line-height: 1.1;
  }

  .product-personalization__hair {
    fill: var(--personalization-hair-color, #75452d);
  }

  .product-personalization__face {
    fill: var(--personalization-skin-color, #bd805d);
  }

  .product-personalization__eye {
    fill: var(--personalization-eye-color, #593a2c);
  }

  .product-personalization__smile {
    fill: none;
    stroke: #8e4d43;
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  .product-personalization__range {
    display: block;
    width: 100%;
    margin: 4px 0 0;
    accent-color: #2d86b6;
    cursor: pointer;
  }

  .product-personalization__range--skin {
    height: 22px;
    margin-block: 0;
    padding: 0;
    appearance: none;
    background: transparent;
  }

  .product-personalization__range--skin::-webkit-slider-runnable-track {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #f6dfcf 0%,
      #edc6aa 16.66%,
      #d8a27f 33.33%,
      #bd805d 50%,
      #986044 66.66%,
      #74472f 83.33%,
      #4d3024 100%
    );
  }

  .product-personalization__range--skin::-moz-range-track {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #f6dfcf 0%,
      #edc6aa 16.66%,
      #d8a27f 33.33%,
      #bd805d 50%,
      #986044 66.66%,
      #74472f 83.33%,
      #4d3024 100%
    );
  }

  .product-personalization__range--skin::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: -5px;
    appearance: none;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #f6d5bd;
    box-shadow: 0 1px 3px rgb(47 34 27 / 24%);
  }

  .product-personalization__range--skin::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #f6d5bd;
    box-shadow: 0 1px 3px rgb(47 34 27 / 24%);
  }

  .product-personalization__range--skin:focus-visible {
    outline: 2px solid #2d86b6;
    outline-offset: 4px;
    border-radius: 999px;
  }

  .product-personalization__range--color {
    height: 22px;
    margin-block: 0;
    padding: 0;
    appearance: none;
    background: transparent;
  }

  .product-personalization__range--color::-webkit-slider-runnable-track {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #e9c878 0%,
      #a86d3d 16.66%,
      #75452d 33.33%,
      #a74732 50%,
      #4b3027 66.66%,
      #242020 83.33%,
      #b8b9bb 100%
    );
  }

  .product-personalization__range--color::-moz-range-track {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #e9c878 0%,
      #a86d3d 16.66%,
      #75452d 33.33%,
      #a74732 50%,
      #4b3027 66.66%,
      #242020 83.33%,
      #b8b9bb 100%
    );
  }

  .product-personalization__range--color::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: -5px;
    appearance: none;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--personalization-thumb-color, #f3e7d3);
    box-shadow: 0 1px 3px rgb(47 34 27 / 24%);
  }

  .product-personalization__range--color::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--personalization-thumb-color, #f3e7d3);
    box-shadow: 0 1px 3px rgb(47 34 27 / 24%);
  }

  .product-personalization__range--color:focus-visible {
    outline: 2px solid #2d86b6;
    outline-offset: 4px;
    border-radius: 999px;
  }

  .product-personalization__range--eye {
    height: 22px;
    margin-block: 0;
    padding: 0;
    appearance: none;
    background: transparent;
  }

  .product-personalization__range--eye::-webkit-slider-runnable-track {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, #593a2c 0%, #4a83a2 33.33%, #66804c 66.66%, #8b7142 100%);
  }

  .product-personalization__range--eye::-moz-range-track {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, #593a2c 0%, #4a83a2 33.33%, #66804c 66.66%, #8b7142 100%);
  }

  .product-personalization__range--eye::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: -5px;
    appearance: none;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--personalization-thumb-color, #f3e7d3);
    box-shadow: 0 1px 3px rgb(47 34 27 / 24%);
  }

  .product-personalization__range--eye::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--personalization-thumb-color, #f3e7d3);
    box-shadow: 0 1px 3px rgb(47 34 27 / 24%);
  }

  .product-personalization__range--eye:focus-visible {
    outline: 2px solid #2d86b6;
    outline-offset: 4px;
    border-radius: 999px;
  }

  .product-personalization__value {
    display: block;
    min-height: 1.4em;
    margin-block-start: var(--padding-2xs);
    color: rgb(var(--color-foreground-rgb) / 75%);
    font-size: 0.9em;
  }

  @media screen and (max-width: 420px) {
    .product-personalization__dialog {
      width: calc(100vw - 16px);
      max-height: calc(100dvh - 16px);
    }

    .product-personalization__modal {
      max-height: calc(100dvh - 16px);
    }

    .product-personalization__modal-header,
    .product-personalization__modal-body {
      padding: var(--padding-md);
    }

    .product-personalization__modal-body {
      grid-template-columns: 1fr;
    }

    .product-personalization__cover-benefits {
      grid-template-columns: 1fr;
    }

    .product-personalization__cover-actions {
      grid-template-columns: 1fr;
    }

    .product-personalization__preview {
      display: none;
    }

    .product-personalization__style-option {
      flex-basis: calc((100% - var(--padding-xs) * 2) / 3);
    }
  }
{% endstylesheet %}

