<section class="about-values" style="--about-values-bg: {{ section.settings.background_color }};">
  <div class="about-values__inner section section--page-width">
    {% for block in section.blocks %}
      <article class="about-values__item" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}<span class="about-values__icon">{{ block.settings.icon }}</span>{% endif %}
        {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
        {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
        {% if block.settings.note != blank %}<span class="about-values__note">{{ block.settings.note }}</span>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .about-values { padding-block: 0 70px; background: var(--about-values-bg, #fff); color: #143d63; }
  .about-values__inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: hidden; border-radius: 12px; background: #fff9ef; }
  .about-values__item { padding: clamp(28px, 4vw, 52px); }
  .about-values__item + .about-values__item { border-inline-start: 1px solid rgb(20 61 99 / 14%); }
  .about-values__icon { display: inline-block; margin-bottom: 10px; font-size: 2.4rem; line-height: 1; }
  .about-values h2 { margin: 0 0 10px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.5rem, 2.3vw, 2.4rem); line-height: 1.05; }
  .about-values p { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; line-height: 1.48; }
  .about-values__note { display: block; margin-top: 16px; color: #2d86b6; font-family: 'Bradley Hand', 'Segoe Print', cursive; font-size: 1.05rem; text-align: right; }
  @media screen and (max-width: 749px) { .about-values__inner { grid-template-columns: 1fr; } .about-values__item + .about-values__item { border-block-start: 1px solid rgb(20 61 99 / 14%); border-inline-start: 0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "About values",
  "max_blocks": 2,
  "blocks": [{
    "type": "value",
    "name": "Value",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "☀" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "What Makes Little Lake Stories Different" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Every Little Lake Story is written from scratch based on your family's real stories and memories. No templates, no shortcuts, just a keepsake made especially for you." },
      { "type": "text", "id": "note", "label": "Handwritten note", "default": "More than a book. A brighter tomorrow." }
    ]
  }],
  "presets": [{ "name": "About values", "blocks": [{ "type": "value", "settings": { "icon": "♟", "heading": "What Makes Little Lake Stories Different" } }, { "type": "value", "settings": { "icon": "☀", "heading": "Our Mission" } }] }],
  "settings": [{ "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" }]
}
{% endschema %}
