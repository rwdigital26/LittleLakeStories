<section class="about-story" style="--about-story-bg: {{ section.settings.background_color }};">
  <div class="about-story__inner">
    <div class="about-story__copy">
      {% if section.settings.eyebrow != blank %}<p class="about-story__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="about-story__text">{{ section.settings.text }}</div>{% endif %}
    </div>
    <div class="about-story__image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 750px) 40vw, 90vw', alt: section.settings.image.alt | default: section.settings.heading, loading: 'lazy' }}
      {% else %}
        <div class="about-story__placeholder">Upload story artwork</div>
      {% endif %}
      {% if section.settings.caption != blank %}<p>{{ section.settings.caption }}</p>{% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .about-story { padding-block: 58px; background: var(--about-story-bg, #fff); color: #143d63; }
  .about-story__inner { display: grid; width: min(calc(100% - 48px), 1280px); grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(32px, 5vw, 76px); margin-inline: auto; }
  .about-story__copy { align-self: center; padding-inline: clamp(8px, 3vw, 44px); }
  .about-story__eyebrow { margin: 0 0 8px; color: #2d86b6; font-family: Georgia, 'Times New Roman', serif; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .about-story h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 3.3vw, 3.6rem); line-height: 1; }
  .about-story__text { max-width: 680px; margin-top: 18px; font-family: Georgia, 'Times New Roman', serif; font-size: 1.05rem; line-height: 1.5; }
  .about-story__text p { margin: 0; }
  .about-story__text p + p { margin-top: 16px; }
  .about-story__image { position: relative; width: min(100%, 520px); justify-self: end; transform: rotate(4deg); }
  .about-story__image img, .about-story__placeholder { display: block; width: 100%; min-height: 270px; border: 8px solid #fff; box-shadow: 0 10px 26px rgb(20 61 99 / 15%); }
  .about-story__image img { height: auto; object-fit: cover; }
  .about-story__placeholder { display: grid; place-items: center; color: #4c7285; background: #eaf8fb; font-family: Georgia, 'Times New Roman', serif; font-weight: 700; text-align: center; }
  .about-story__image p { margin: 12px 0 0; color: #2d86b6; font-family: 'Bradley Hand', 'Segoe Print', cursive; font-size: 1.05rem; text-align: center; }
  @media screen and (max-width: 749px) { .about-story__inner { width: min(calc(100% - 32px), 1280px); grid-template-columns: 1fr; } .about-story__copy { padding-inline: 0; } .about-story__image { max-width: 440px; margin-inline: auto; justify-self: center; } }
{% endstylesheet %}

{% schema %}
{
  "name": "About story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories Made at the Lake" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Little Lake Stories started with a simple idea: capture the memories that make a place feel like home. Every story is written from scratch and illustrated with the people and places families love most.</p>" },
    { "type": "image_picker", "id": "image", "label": "Artwork" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "Real families. Real stories. A brighter tomorrow." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "About story" }]
}
{% endschema %}
