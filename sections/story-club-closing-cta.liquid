{% liquid
  assign join_link = section.settings.join_link | default: routes.all_products_collection_url
  assign gift_link = section.settings.gift_link | default: '#story-club-gifts'
%}

<section class="story-club-closing-cta" aria-labelledby="StoryClubClosingHeading-{{ section.id }}">
  <div class="story-club-closing-cta__media" aria-hidden="true">
    <img
      src="https://cdn.shopify.com/s/files/1/0831/8376/3710/files/Watercolor_Lakeside_Sunset_Retreat.png?v=1791345742"
      alt=""
      width="2172"
      height="724"
      loading="eager"
    >
  </div>
  <div class="story-club-closing-cta__veil" aria-hidden="true"></div>

  <div class="story-club-closing-cta__content">
    <h2 id="StoryClubClosingHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.subheading | escape }}</p>
    <a class="story-club-closing-cta__join" href="{{ join_link }}">
      {{ section.settings.join_label | escape }}
      <span aria-hidden="true">→</span>
    </a>
    <a class="story-club-closing-cta__gift" href="{{ gift_link }}">
      {{ section.settings.gift_label | escape }}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

{% stylesheet %}
  .story-club-closing-cta {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 430px;
    place-items: center;
    overflow: hidden;
    background: #eaf4fa;
    color: #143d63;
    text-align: center;
  }

  .story-club-closing-cta__media,
  .story-club-closing-cta__veil {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .story-club-closing-cta__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .story-club-closing-cta__veil {
    z-index: 1;
    background: rgb(255 255 255 / 20%);
    pointer-events: none;
  }

  .story-club-closing-cta__content {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(100% - 48px, 780px);
    flex-direction: column;
    align-items: center;
    padding-block: 42px;
  }

  .story-club-closing-cta h2 {
    max-width: 19ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 44px;
    line-height: 1.04;
  }

  .story-club-closing-cta p {
    max-width: 66ch;
    margin: 12px 0 20px;
    font-family: var(--font-heading--family);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }

  .story-club-closing-cta__join {
    display: inline-flex;
    width: min(100%, 370px);
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px 24px;
    border-radius: 999px;
    background: #0b4b78;
    color: #fff;
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .story-club-closing-cta__join:hover {
    transform: translateY(-2px);
    background: #143d63;
  }

  .story-club-closing-cta__gift {
    margin-top: 16px;
    color: #143d63;
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .story-club-closing-cta__gift span {
    margin-inline-start: 4px;
  }

  @media screen and (max-width: 749px) {
    .story-club-closing-cta {
      min-height: 500px;
    }

    .story-club-closing-cta__media img {
      object-position: center;
    }

    .story-club-closing-cta__veil {
      background: rgb(255 255 255 / 34%);
    }

    .story-club-closing-cta__content {
      width: calc(100% - 36px);
      padding-block: 36px;
    }

    .story-club-closing-cta h2 {
      max-width: 15ch;
      font-size: 34px;
    }

    .story-club-closing-cta p {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story Club closing CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Childhood Happens One Story at a Time." },
    { "type": "textarea", "id": "subheading", "label": "Text", "default": "Join the Little Lake Story Club and turn their everyday moments into a collection of adventures they’ll cherish forever." },
    { "type": "text", "id": "join_label", "label": "Join button label", "default": "Join the Story Club" },
    { "type": "url", "id": "join_link", "label": "Join button link" },
    { "type": "text", "id": "gift_label", "label": "Gift link label", "default": "Give a Gift Membership" },
    { "type": "url", "id": "gift_link", "label": "Gift link" }
  ],
  "presets": [
    { "name": "Story Club closing CTA" }
  ]
}
{% endschema %}