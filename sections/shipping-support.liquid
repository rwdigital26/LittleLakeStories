<section class="shipping-support" style="--shipping-support-bg: {{ section.settings.background_color }};">
  <div class="shipping-support__inner section section--page-width">
    <div class="shipping-support__grid">
      {% for block in section.blocks %}
        <div class="shipping-support__item shipping-support__item--{{ block.settings.color }}" {{ block.shopify_attributes }}>
          <div class="shipping-support__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'compass' %}
                <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                  <circle cx="32" cy="32" r="17" fill="none" stroke="currentColor" stroke-width="2.8"/>
                  <path d="M39 25l-5 10-10 5 5-10z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                </svg>
              {% when 'heart' %}
                <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                  <path d="M32 52s-17-10.7-21.3-20.8C8.5 25.3 13.2 15 22.4 15c5 0 8.1 2.8 9.6 5.1 1.5-2.3 4.6-5.1 9.6-5.1 9.2 0 13.9 10.3 11.7 16.2C49 41.3 32 52 32 52Z" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% else %}
                <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                  <path d="M12 22l20-9 20 9-20 9z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/>
                  <path d="M12 22v20l20 9 20-9V22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/>
                  <path d="M32 31v20" fill="none" stroke="currentColor" stroke-width="2.6"/>
                </svg>
            {% endcase %}
          </div>

          <div class="shipping-support__copy">
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="shipping-support__text">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.note != blank %}
              <p class="shipping-support__note">{{ block.settings.note }}</p>
            {% endif %}

            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="shipping-support__button">
                {{ block.settings.button_label }} <span aria-hidden="true">→</span>
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .shipping-support {
    background: var(--shipping-support-bg, #ffffff);
    color: #143d63;
    padding-block: 0 56px;
  }

  .shipping-support h3,
  .shipping-support p,
  .shipping-support__text {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .shipping-support__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
  }

  .shipping-support__item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .shipping-support__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 50%;
  }

  .shipping-support__icon svg {
    display: block;
    width: 28px;
    height: 28px;
  }

  .shipping-support__item--green .shipping-support__icon {
    color: #143d63;
    background: #dfeadb;
  }

  .shipping-support__item--blue .shipping-support__icon {
    color: #143d63;
    background: #d8ecf6;
  }

  .shipping-support__item--pink .shipping-support__icon {
    color: #b95c5c;
    background: #f5dcdc;
  }

  .shipping-support__copy h3 {
    margin: 0 0 8px;
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    line-height: 1.2;
  }

  .shipping-support__text p {
    margin: 0 0 10px;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .shipping-support__text p:last-child {
    margin-bottom: 0;
  }

  .shipping-support__text em {
    font-style: italic;
  }

  .shipping-support__note {
    margin: 10px 0 0;
    font-size: 0.92rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.45;
  }

  .shipping-support__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding: 10px 20px;
    border: 1px solid #143d63;
    border-radius: 999px;
    color: #143d63;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    text-decoration: none;
  }

  .shipping-support__button:hover {
    background: rgba(20, 61, 99, 0.08);
  }

  @media screen and (max-width: 989px) {
    .shipping-support__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping support",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "box",
          "options": [
            { "label": "Box", "value": "box" },
            { "label": "Compass", "value": "compass" },
            { "label": "Heart", "value": "heart" }
          ]
        },
        {
          "type": "select",
          "id": "color",
          "label": "Color",
          "default": "green",
          "options": [
            { "label": "Green", "value": "green" },
            { "label": "Blue", "value": "blue" },
            { "label": "Pink", "value": "pink" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tracking Your Order" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Once your book ships, tracking details will be provided if available through the selected shipping service.</p>"
        },
        { "type": "text", "id": "note", "label": "Note (italic, optional)", "default": "Please note that shipping estimates begin after your personalized book has been approved and printed." },
        { "type": "text", "id": "button_label", "label": "Button label (optional)" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" }
  ],
  "presets": [
    {
      "name": "Shipping support",
      "blocks": [
        { "type": "item", "settings": { "icon": "box", "color": "green", "heading": "Tracking Your Order", "text": "<p>Once your book ships, tracking details will be provided if available through the selected shipping service.</p>", "note": "Please note that shipping estimates begin after your personalized book has been approved and printed." } },
        { "type": "item", "settings": { "icon": "compass", "color": "blue", "heading": "Shipping Delays", "text": "<p>While we work hard to get your special story to you as quickly as possible, delivery times may occasionally be affected by holidays, severe weather, shipping carrier delays, or other circumstances beyond our control.</p><p>We appreciate your patience as we bring your family's story to life.</p>" } },
        { "type": "item", "settings": { "icon": "heart", "color": "pink", "heading": "Questions?", "text": "<p>We're here to help! If you have any questions about your order or delivery, please visit our Contact Us page. We'd love to hear from you!</p>", "button_label": "Contact Us", "button_link": "shopify://pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
