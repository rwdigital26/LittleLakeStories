<section class="how-it-works-steps" style="--how-it-works-steps-bg: {{ section.settings.background_color }}; --how-it-works-steps-padding-top: {{ section.settings.padding_top }}px; --how-it-works-steps-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="how-it-works-steps__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="how-it-works-steps__subheading">{{ section.settings.subheading }}</p>{% endif %}
    <div class="how-it-works-steps__art">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '960, 1280, 1600, 1800', sizes: 'min(100vw - 48px, 1400px)', alt: section.settings.image.alt | default: section.settings.heading, loading: 'lazy' }}
      {% else %}
        <img src="{{ 'how-it-works-steps.png' | asset_url }}" alt="Six simple steps to create a Little Lake Story" width="961" height="265" loading="lazy">
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .how-it-works-steps {
    padding-block: var(--how-it-works-steps-padding-top, 56px) var(--how-it-works-steps-padding-bottom, 80px);
    background: var(--how-it-works-steps-bg, #fff);
    color: #143d63;
  }

  .how-it-works-steps__inner {
    width: min(100% - 48px, 1400px);
    margin-inline: auto;
    text-align: center;
  }

  .how-it-works-steps h2,
  .how-it-works-steps p {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .how-it-works-steps h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1;
  }

  .how-it-works-steps__subheading {
    margin: 12px 0 32px;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 700;
  }

  .how-it-works-steps__art {
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 5px 18px rgb(20 61 99 / 7%);
  }

  .how-it-works-steps__art img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .how-it-works-steps {
      padding-block: 40px 60px;
    }

    .how-it-works-steps__inner {
      width: min(100% - 32px, 600px);
    }

    .how-it-works-steps__subheading {
      margin-bottom: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How It Works steps",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Steps image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six Simple Steps to Their Story" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "A meaningful, stress-free experience from start to finish." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    { "name": "How It Works steps" }
  ]
}
{% endschema %}
