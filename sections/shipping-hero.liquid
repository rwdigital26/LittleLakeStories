<section class="shipping-hero" style="--shipping-hero-bg: {{ section.settings.background_color }};">
  <div class="shipping-hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt | default: section.settings.heading, loading: 'eager' }}
    {% else %}
      <div class="shipping-hero__placeholder">Upload hero image</div>
    {% endif %}
  </div>
  <div class="shipping-hero__content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    {% if section.settings.description != blank %}<div class="shipping-hero__description">{{ section.settings.description }}</div>{% endif %}
  </div>
</section>

{% stylesheet %}
  .shipping-hero {
    position: relative;
    min-height: clamp(420px, 40vw, 640px);
    margin-bottom: 75px;
    overflow: hidden;
    background: var(--shipping-hero-bg, #eaf8fb);
    color: #143d63;
  }

  .shipping-hero__media,
  .shipping-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .shipping-hero__media img {
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .shipping-hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.05rem;
    color: #2d86b6;
    background: #eaf8fb;
  }

  .shipping-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(46%, 680px);
    min-height: clamp(420px, 40vw, 640px);
    padding: clamp(40px, 7vw, 96px);
    background: linear-gradient(90deg, rgb(255 255 255 / 92%) 0%, rgb(255 255 255 / 74%) 70%, rgb(255 255 255 / 0%) 100%);
  }

  .shipping-hero h1,
  .shipping-hero p,
  .shipping-hero__description {
    max-width: 600px;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .shipping-hero h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    line-height: 0.98;
  }

  .shipping-hero p {
    margin: 18px 0 0;
    font-size: clamp(1.25rem, 2vw, 2rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.15;
  }

  .shipping-hero__description {
    margin-block-start: 20px;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .shipping-hero {
      min-height: 620px;
      margin-bottom: 52px;
    }

    .shipping-hero__media img {
      object-position: 62% center;
    }

    .shipping-hero__content {
      justify-content: flex-start;
      width: 100%;
      min-height: 100%;
      padding: 48px 24px;
      background: linear-gradient(180deg, rgb(255 255 255 / 92%) 0%, rgb(255 255 255 / 64%) 54%, rgb(255 255 255 / 0%) 100%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & Delivery" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Made with love. Printed in the USA. Delivered to your door." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Every Little Lake Story book is a one-of-a-kind keepsake, thoughtfully created for your family and shipped with care." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#eaf8fb" }
  ],
  "presets": [
    { "name": "Shipping hero" }
  ]
}
{% endschema %}
