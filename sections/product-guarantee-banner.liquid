{% liquid
  assign is_subscription_product = false
  if product != blank and product.tags contains 'Subscription'
    assign is_subscription_product = true
  endif
%}

<section class="product-guarantee-banner{% if is_subscription_product %} product-guarantee-banner--included{% endif %}" style="--product-guarantee-banner-bg: {{ section.settings.background_color }};">
  <svg class="product-guarantee-banner__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 30C240 60 480 0 720 15C960 30 1200 60 1440 30V0H0Z" fill="currentColor"/>
  </svg>

  <div class="product-guarantee-banner__inner section section--page-width">
    {% if is_subscription_product %}
      <header class="product-guarantee-banner__header">
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.subheading | escape }}</p>
      </header>
    {% endif %}
    <div class="product-guarantee-banner__row">
      {% liquid
        assign feature_limit = 3
        if is_subscription_product
          assign feature_limit = 6
        endif
      %}
      {% for block in section.blocks limit: feature_limit %}
        {% liquid
          assign feature_heading = block.settings.heading
          assign feature_text = block.settings.text
          if is_subscription_product
            assign feature_heading = block.settings.subscription_heading | default: block.settings.heading
            assign feature_text = block.settings.subscription_text | default: block.settings.text
          endif
        %}
        <div class="product-guarantee-banner__item" {{ block.shopify_attributes }}>
          <div class="product-guarantee-banner__icon" aria-hidden="true">
            {% if is_subscription_product and block.settings.icon_url != blank %}
              <img src="{{ block.settings.icon_url | escape }}" alt="" width="56" height="56" loading="eager">
            {% else %}
              {% case block.settings.icon %}
                {% when 'heart' %}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <path d="M32 52s-17-10.7-21.3-20.8C8.5 25.3 13.2 15 22.4 15c5 0 8.1 2.8 9.6 5.1 1.5-2.3 4.6-5.1 9.6-5.1 9.2 0 13.9 10.3 11.7 16.2C49 41.3 32 52 32 52Z" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'smiley' %}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <circle cx="32" cy="32" r="20" fill="none" stroke="currentColor" stroke-width="2.8"/>
                    <circle cx="24" cy="28" r="2.4" fill="currentColor"/>
                    <circle cx="40" cy="28" r="2.4" fill="currentColor"/>
                    <path d="M22 38c3 4 7 6 10 6s7-2 10-6" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <rect x="14" y="26" width="36" height="26" rx="2" fill="none" stroke="currentColor" stroke-width="2.8"/>
                    <path d="M14 26h36" stroke="currentColor" stroke-width="2.8"/>
                    <path d="M32 26v26" stroke="currentColor" stroke-width="2.8"/>
                    <path d="M32 26c-4-10-16-10-16-2 0 2 2 2 4 2h12z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                    <path d="M32 26c4-10 16-10 16-2 0 2-2 2-4 2h-12z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            {% endif %}
          </div>

          <div class="product-guarantee-banner__copy">
            {% if block.settings.heading != blank %}
              <p class="product-guarantee-banner__heading">{{ feature_heading | escape }}</p>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="product-guarantee-banner__text">{{ feature_text | escape }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-guarantee-banner {
    position: relative;
    background: var(--product-guarantee-banner-bg, #eaf3fb);
    color: #143d63;
    padding-block: 12px 40px;
  }

  .product-guarantee-banner__wave {
    display: block;
    width: 100%;
    height: 32px;
    color: #eaf3fb;
    transform: translateY(-1px);
  }

  .product-guarantee-banner h2,
  .product-guarantee-banner p {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .product-guarantee-banner__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .product-guarantee-banner--included {
    padding-block: 18px 52px;
    background: #fff;
  }

  .product-guarantee-banner--included .product-guarantee-banner__wave {
    color: #fff;
  }

  .product-guarantee-banner__header {
    margin-block: 8px 24px;
  }

  .product-guarantee-banner__header h2 {
    margin: 0;
    color: #143d63;
    font-family: var(--font-heading--family);
    font-size: 34px;
    line-height: 1.08;
  }

  .product-guarantee-banner__header p {
    margin: 6px 0 0;
    color: #2d86b6;
    font-size: 16px;
  }

  .product-guarantee-banner--included .product-guarantee-banner__row {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .product-guarantee-banner--included .product-guarantee-banner__item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: start;
    gap: 10px;
    min-height: 94px;
    padding: 14px 18px;
    border-inline-end: 1px solid #e8edf0;
    text-align: left;
  }

  .product-guarantee-banner--included .product-guarantee-banner__copy {
    min-width: 0;
  }

  .product-guarantee-banner--included .product-guarantee-banner__item:nth-child(3n) {
    border-inline-end: 0;
  }

  .product-guarantee-banner--included .product-guarantee-banner__icon {
    width: 44px;
    height: 44px;
    margin: 0;
  }

  .product-guarantee-banner--included .product-guarantee-banner__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-guarantee-banner--included .product-guarantee-banner__heading {
    font-size: 15px;
    line-height: 1.2;
  }

  .product-guarantee-banner--included .product-guarantee-banner__text {
    margin-top: 5px;
    font-size: 12px;
    line-height: 1.35;
  }

  .product-guarantee-banner__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .product-guarantee-banner__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 10px;
    color: #143d63;
  }

  .product-guarantee-banner__icon svg {
    display: block;
    width: 34px;
    height: 34px;
  }

  .product-guarantee-banner__heading {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .product-guarantee-banner__text {
    margin: 4px 0 0;
    font-size: 0.92rem;
    font-weight: 500;
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .product-guarantee-banner__row {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .product-guarantee-banner--included {
      padding-block: 16px 36px;
    }

    .product-guarantee-banner--included .product-guarantee-banner__header h2 {
      font-size: 30px;
    }

    .product-guarantee-banner--included .product-guarantee-banner__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    .product-guarantee-banner--included .product-guarantee-banner__item {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 8px;
      min-height: 112px;
      padding: 12px 8px;
      border-inline-end: 0;
      border-block-end: 1px solid #e8edf0;
    }

    .product-guarantee-banner--included .product-guarantee-banner__item:nth-child(3n) {
      border-inline-end: 0;
    }

    .product-guarantee-banner--included .product-guarantee-banner__icon {
      width: 36px;
      height: 36px;
    }

    .product-guarantee-banner--included .product-guarantee-banner__heading {
      font-size: 13px;
    }

    .product-guarantee-banner--included .product-guarantee-banner__text {
      font-size: 11px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product guarantee banner",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "gift",
          "options": [
            { "label": "Gift", "value": "gift" },
            { "label": "Heart", "value": "heart" },
            { "label": "Smiley", "value": "smiley" }
          ]
        },
        { "type": "text", "id": "icon_url", "label": "Icon image URL" },
        { "type": "text", "id": "subscription_heading", "label": "Subscription-only heading" },
        { "type": "textarea", "id": "subscription_text", "label": "Subscription-only text" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Makes the Perfect Gift" },
        { "type": "text", "id": "text", "label": "Text (optional)" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Subscription heading", "default": "What’s Included" },
    { "type": "text", "id": "subheading", "label": "Subscription subheading", "default": "Everything you need for a year of meaningful adventures." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#eaf3fb" }
  ],
  "presets": [
    {
      "name": "Product guarantee banner",
      "blocks": [
        { "type": "item", "settings": { "icon": "gift", "heading": "Makes the Perfect Gift", "text": "Your loved one will love it" } },
        { "type": "item", "settings": { "icon": "heart", "heading": "Tears of Joy May Be Seen", "text": "Makes the most precious gift" } },
        { "type": "item", "settings": { "icon": "smiley", "heading": "Love it Guarantee", "text": "Love it or your money back" } }
      ]
    }
  ]
}
{% endschema %}
