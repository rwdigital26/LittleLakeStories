{% assign has_blocks = false %}
{% if section.blocks.size > 0 %}
  {% assign has_blocks = true %}
{% endif %}

<section class="how-it-works section section--page-width" style="--how-it-works-bg: {{ section.settings.background_color }};">
  <header class="how-it-works__header">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </header>

  <div class="how-it-works__steps">
    {% if has_blocks %}
      {% for block in section.blocks %}
        <article class="how-it-works__step" {{ block.shopify_attributes }}>
          <div class="how-it-works__illustration">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 30vw, 90vw', alt: block.settings.heading, loading: 'lazy' }}
            {% else %}
              <div class="how-it-works__placeholder" aria-hidden="true">
                <span>{{ forloop.index }}</span>
              </div>
            {% endif %}
          </div>
          <div class="how-it-works__step-copy">
            <span class="how-it-works__number">{{ forloop.index }}</span>
            <div>
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.description }}</p>
            </div>
          </div>
        </article>
      {% endfor %}
    {% else %}
      {% assign steps = '1,2,3,4,5,6' | split: ',' %}
      {% for step in steps %}
        {% liquid
          assign image_key = 'image_' | append: step
          assign title_key = 'title_' | append: step
          assign description_key = 'description_' | append: step
        %}
        <article class="how-it-works__step">
          <div class="how-it-works__illustration">
            {% if section.settings[image_key] != blank %}
              {{ section.settings[image_key] | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 30vw, 90vw', alt: section.settings[title_key], loading: 'lazy' }}
            {% else %}
              <div class="how-it-works__placeholder" aria-hidden="true">
                {% case step %}
                  {% when '1' %}<span>↔</span>
                  {% when '2' %}<span>✦</span>
                  {% when '3' %}<span>▤</span>
                  {% when '4' %}<span>✎</span>
                  {% when '5' %}<span>✓</span>
                  {% when '6' %}<span>✧</span>
                {% endcase %}
              </div>
            {% endif %}
          </div>
          <div class="how-it-works__step-copy">
            <span class="how-it-works__number">{{ step }}</span>
            <div>
              <h3>{{ section.settings[title_key] }}</h3>
              <p>{{ section.settings[description_key] }}</p>
            </div>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .how-it-works {
    --how-it-works-ink: #143d63;
    --how-it-works-blue: #2d86b6;
    padding-block: 24px 90px;
    background: linear-gradient(180deg, #ffffff 0%, #f6fbfe 100%);
    color: var(--how-it-works-ink);
  }

  .how-it-works__header {
    max-width: 900px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .how-it-works h2,
  .how-it-works h3,
  .how-it-works p {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .how-it-works__header p {
    margin: 0 0 12px;
    color: #2d86b6;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .how-it-works h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .how-it-works__header p:last-child {
    margin-top: 12px;
    color: #143d63;
    font-size: 1.12rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .how-it-works__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 54px;
    align-items: start;
  }

  .how-it-works__step {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .how-it-works__step:not(:nth-child(3n))::after {
    content: "";
    position: absolute;
    right: -30px;
    top: 110px;
    width: 30px;
    height: 2px;
    background: #2d86b6;
  }

  .how-it-works__step:not(:nth-child(3n))::before {
    content: "";
    position: absolute;
    right: -32px;
    top: 102px;
    width: 0;
    height: 0;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 11px solid #2d86b6;
  }

  .how-it-works__illustration {
    display: grid;
    place-items: center;
    margin-block-end: 14px;
    overflow: hidden;
    border-radius: 22px;
    background: linear-gradient(180deg, #edf9ff 0%, #f7f6ef 100%);
    box-shadow: 0 18px 28px rgb(20 61 99 / 10%);
  }

  .how-it-works__illustration img {
    display: block;
    width: 100%;
    height: auto;
  }

  .how-it-works__placeholder {
    display: grid;
    place-items: center;
    width: 170px;
    height: 140px;
    border-radius: 50% 50% 45% 45%;
    color: #fff;
    background: linear-gradient(145deg, #b9e5f3, #eaf8fb);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 4rem;
    font-weight: 700;
    box-shadow: 0 10px 22px rgb(20 61 99 / 10%);
  }

  .how-it-works__placeholder span {
    transform: translateY(-4px);
  }

  .how-it-works__step-copy {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    width: 100%;
    margin-block-start: 28px;
    padding-block: 8px 2px;
    background: transparent;
  }

  .how-it-works__number {
    display: grid;
    place-items: center;
    width: 48px;
    aspect-ratio: 1;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, #2d86b6, #143d63);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.45rem;
    font-weight: 700;
    box-shadow: 0 8px 18px rgb(20 61 99 / 14%);
  }

  .how-it-works h3 {
    margin: 2px 0 8px;
    font-size: clamp(1.3rem, 1.8vw, 1.8rem);
    line-height: 1.08;
  }

  .how-it-works__step-copy p {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .how-it-works__step:nth-child(3n + 1) { grid-column: 1; }
    .how-it-works__step:nth-child(3n + 2) { grid-column: 2; }
    .how-it-works__step:nth-child(3n + 3) { grid-column: 3; }
  }

  @media screen and (max-width: 749px) {
    .how-it-works {
      padding-block: 0 75px;
    }

    .how-it-works__steps {
      grid-template-columns: 1fr;
      gap: 32px;
    }

  }
{% endstylesheet %}

