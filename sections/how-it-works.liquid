{% assign steps = '1,2,3' | split: ',' %}

<section class="how-it-works section section--page-width" style="--how-it-works-bg: {{ section.settings.background_color }};">
  <header class="how-it-works__header">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </header>

  <div class="how-it-works__steps">
    {% for step in steps %}
      {% liquid
        assign image_key = 'image_' | append: step
        assign title_key = 'title_' | append: step
        assign description_key = 'description_' | append: step
      %}
      <article class="how-it-works__step">
        <div class="how-it-works__illustration">
          {% if section.settings[image_key] != blank %}
            {{ section.settings[image_key] | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 30vw, 90vw', alt: section.settings[title_key], loading: 'lazy' }}
          {% else %}
            <div class="how-it-works__placeholder" aria-hidden="true">
              {% case step %}
                {% when '1' %}<span>↔</span>
                {% when '2' %}<span>✦</span>
                {% when '3' %}<span>▤</span>
              {% endcase %}
            </div>
          {% endif %}
        </div>
        <div class="how-it-works__step-copy">
          <span class="how-it-works__number">{{ step }}</span>
          <div>
            <h3>{{ section.settings[title_key] }}</h3>
            <p>{{ section.settings[description_key] }}</p>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .how-it-works {
    --how-it-works-ink: #143d63;
    --how-it-works-blue: #2d86b6;
    padding-block: 72px 88px;
    background: var(--how-it-works-bg, #fff);
    color: var(--how-it-works-ink);
  }

  .how-it-works__header {
    max-width: 820px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .how-it-works h2,
  .how-it-works h3,
  .how-it-works p {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .how-it-works h2 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1;
  }

  .how-it-works__header p {
    margin: 10px 0 0;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .how-it-works__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 42px;
  }

  .how-it-works__step {
    min-width: 0;
  }

  .how-it-works__illustration {
    display: grid;
    place-items: center;
    height: 190px;
    margin-block-end: 22px;
  }

  .how-it-works__illustration img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .how-it-works__placeholder {
    display: grid;
    place-items: center;
    width: 170px;
    height: 140px;
    border-radius: 50% 50% 45% 45%;
    color: #fff;
    background: linear-gradient(145deg, #b9e5f3, #eaf8fb);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 4rem;
    font-weight: 700;
    box-shadow: 0 10px 22px rgb(20 61 99 / 10%);
  }

  .how-it-works__placeholder span {
    transform: translateY(-4px);
  }

  .how-it-works__step-copy {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    position: relative;
    z-index: 1;
    padding-block: 0 8px;
    background: var(--how-it-works-bg, #fff);
  }

  .how-it-works__number {
    display: grid;
    place-items: center;
    width: 44px;
    aspect-ratio: 1;
    border-radius: 50%;
    color: #fff;
    background: var(--how-it-works-blue);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .how-it-works h3 {
    margin: 4px 0 8px;
    font-size: clamp(1.2rem, 1.6vw, 1.7rem);
    line-height: 1.1;
  }

  .how-it-works__step-copy p {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    .how-it-works {
      padding-block: 52px 64px;
    }

    .how-it-works__steps {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .how-it-works__illustration {
      height: 150px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From our lake to your little one's imagination — in three simple steps." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "header", "content": "Step one" },
    { "type": "image_picker", "id": "image_1", "label": "Illustration" },
    { "type": "text", "id": "title_1", "label": "Title", "default": "Choose Your Lake" },
    { "type": "textarea", "id": "description_1", "label": "Description", "default": "Pick Delavan Lake, Lake Geneva, or a grandparents theme." },
    { "type": "header", "content": "Step two" },
    { "type": "image_picker", "id": "image_2", "label": "Illustration" },
    { "type": "text", "id": "title_2", "label": "Title", "default": "Personalize Your Story" },
    { "type": "textarea", "id": "description_2", "label": "Description", "default": "Add your child's name, appearance, family members and favorite activities." },
    { "type": "header", "content": "Step three" },
    { "type": "image_picker", "id": "image_3", "label": "Illustration" },
    { "type": "text", "id": "title_3", "label": "Title", "default": "Order Your Keepsake" },
    { "type": "textarea", "id": "description_3", "label": "Description", "default": "We bring the story to life and ship it to your door, ready to be loved for years to come." }
  ],
  "presets": [
    { "name": "How it works" }
  ]
}
{% endschema %}
