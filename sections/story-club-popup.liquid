<story-club-popup
  class="story-club-popup"
  data-delay="{{ section.settings.delay_seconds | times: 1000 }}"
  data-storage-key="little-lake-story-club-popup-shown"
>
  <dialog class="story-club-popup__dialog" data-popup-dialog aria-labelledby="StoryClubPopupHeading-{{ section.id }}">
    <div class="story-club-popup__panel">
      <button class="story-club-popup__close" type="button" data-popup-close aria-label="Close offer">
        <span aria-hidden="true">&times;</span>
      </button>

      <div class="story-club-popup__content">
        {% if section.settings.eyebrow != blank %}
          <p class="story-club-popup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 id="StoryClubPopupHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="story-club-popup__offer">{{ section.settings.offer_lead | escape }}</p>
        <p class="story-club-popup__price">{{ section.settings.price | escape }}</p>
        <p class="story-club-popup__description">{{ section.settings.description | escape }}</p>

        <p class="story-club-popup__coupon"><span aria-hidden="true">&#9825;</span> {{ section.settings.coupon_note | escape }}</p>

        <ul class="story-club-popup__benefits">
          <li><span class="story-club-popup__benefit-icon" aria-hidden="true">&#9825;</span><span>Personalized<br>for your child</span></li>
          <li><span class="story-club-popup__benefit-icon" aria-hidden="true">&#10022;</span><span>A new adventure<br>every month</span></li>
          <li><span class="story-club-popup__benefit-icon" aria-hidden="true">&#9633;</span><span>Shipping<br>included</span></li>
        </ul>

        <a class="story-club-popup__join" href="{{ section.settings.join_link }}">
          {{ section.settings.join_label | escape }} <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="story-club-popup__gift" href="{{ section.settings.gift_link }}">
          <span aria-hidden="true">&#127873;</span> {{ section.settings.gift_label | escape }}
        </a>
        {% if section.settings.fine_print != blank %}
          <p class="story-club-popup__fine-print">{{ section.settings.fine_print | escape }}</p>
        {% endif %}
      </div>

      <div class="story-club-popup__image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 45vw, 100vw', alt: 'A child and dog sharing a story beside the lake', loading: 'lazy' }}
        {% else %}
          <img
            src="https://cdn.shopify.com/s/files/1/0831/8376/3710/files/Child_and_Dog_at_Sunset_Lake.png?v=1791338391&width=1400"
            alt="A child and dog sharing a story beside the lake"
            width="1400"
            height="1600"
            loading="lazy"
          >
        {% endif %}
      </div>
    </div>
  </dialog>
</story-club-popup>

<script src="{{ 'story-club-popup.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .story-club-popup__dialog {
    width: min(920px, calc(100vw - 32px));
    max-width: none;
    max-height: min(720px, calc(100dvh - 32px));
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: 18px;
    color: #143d63;
    background: #fff;
    box-shadow: 0 24px 80px rgb(8 31 51 / 32%);
  }

  .story-club-popup__dialog::backdrop {
    background: rgb(11 34 52 / 58%);
    backdrop-filter: blur(5px);
  }

  .story-club-popup__panel {
    position: relative;
    display: grid;
    min-height: 620px;
    grid-template-columns: 1.04fr 0.96fr;
    overflow: hidden;
  }

  .story-club-popup__close {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #143d63;
    background: rgb(255 255 255 / 88%);
    cursor: pointer;
    font: inherit;
    font-size: 32px;
    line-height: 1;
  }

  .story-club-popup__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 38px 34px 28px;
    text-align: center;
    background: #fff;
  }

  .story-club-popup__eyebrow {
    margin: 0 0 14px;
    color: #17669e;
    font-family: var(--font-body--family);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .story-club-popup__content h2 {
    max-width: 430px;
    margin: 0;
    color: #102e50;
    font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
    font-size: 2.85rem;
    line-height: 0.99;
  }

  .story-club-popup__offer {
    margin: 16px 0 -4px;
    color: #143d63;
    font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
    font-size: 1.55rem;
    line-height: 1.15;
  }

  .story-club-popup__price {
    margin: 0;
    color: #d92850;
    font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
    font-size: 5.25rem;
    font-weight: 800;
    line-height: 1;
  }

  .story-club-popup__description {
    max-width: 400px;
    margin: 6px 0 12px;
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .story-club-popup__coupon {
    margin: 0;
    padding: 6px 18px;
    border-radius: 999px;
    color: #143d63;
    background: #ffe1df;
    font-size: 0.85rem;
  }

  .story-club-popup__coupon span {
    margin-inline-end: 5px;
    color: #e13b60;
    font-size: 1.15rem;
  }

  .story-club-popup__benefits {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 16px 0 18px;
    padding: 0;
    list-style: none;
  }

  .story-club-popup__benefits li {
    display: grid;
    justify-items: center;
    gap: 5px;
    font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .story-club-popup__benefit-icon {
    display: grid;
    width: 60px;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    color: #12629a;
    background: #fff1ef;
    font-family: var(--font-body--family);
    font-size: 1.8rem;
  }

  .story-club-popup__join {
    display: flex;
    width: min(100%, 360px);
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 20px;
    border-radius: 999px;
    color: #fff;
    background: #12609a;
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .story-club-popup__join:hover {
    background: #0e4773;
  }

  .story-club-popup__gift {
    margin-top: 8px;
    color: #155d95;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .story-club-popup__fine-print {
    margin: 12px 0 0;
    color: #60788d;
    font-size: 0.68rem;
  }

  .story-club-popup__image {
    min-width: 0;
    min-height: 100%;
    background: #dff1f7;
  }

  .story-club-popup__image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 620px;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (max-width: 700px) {
    .story-club-popup__dialog {
      max-height: calc(100dvh - 24px);
      width: calc(100vw - 24px);
      border-radius: 14px;
    }

    .story-club-popup__panel {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .story-club-popup__content {
      order: 2;
      padding: 24px 20px 20px;
    }

    .story-club-popup__image {
      order: 1;
      height: 175px;
      min-height: 0;
    }

    .story-club-popup__image img {
      height: 175px;
      min-height: 0;
      object-position: center 55%;
    }

    .story-club-popup__content h2 {
      max-width: 320px;
      font-size: 2.1rem;
    }

    .story-club-popup__offer {
      font-size: 1.25rem;
    }

    .story-club-popup__price {
      font-size: 4.25rem;
    }

    .story-club-popup__benefit-icon {
      width: 48px;
      font-size: 1.45rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .story-club-popup__dialog[open] .story-club-popup__panel {
      animation: story-club-popup-enter 220ms ease-out both;
    }

    @keyframes story-club-popup-enter {
      from { opacity: 0; transform: translateY(12px) scale(0.99); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story Club popup",
  "settings": [
    { "type": "range", "id": "delay_seconds", "label": "Delay after page load", "min": 1, "max": 15, "step": 1, "unit": "s", "default": 3 },
    { "type": "image_picker", "id": "image", "label": "Popup image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited-time launch special" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Little Lake Story Club" },
    { "type": "text", "id": "offer_lead", "label": "Offer lead", "default": "Get Your First Book for Just" },
    { "type": "text", "id": "price", "label": "Price", "default": "$1.00" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Start their personalized storybook subscription with a magical first book delivered for only $1.00." },
    { "type": "text", "id": "coupon_note", "label": "Coupon note", "default": "No coupon code needed" },
    { "type": "text", "id": "join_label", "label": "Join button", "default": "Join the Story Club" },
    { "type": "url", "id": "join_link", "label": "Join link" },
    { "type": "text", "id": "gift_label", "label": "Gift link label", "default": "Give a Gift Membership" },
    { "type": "url", "id": "gift_link", "label": "Gift link" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Choose from 3, 6, or 12 month plans." }
  ]
}
{% endschema %}