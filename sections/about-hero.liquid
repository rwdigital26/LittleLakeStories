<section class="about-hero" style="--about-hero-bg: {{ section.settings.background_color }};">
  <div class="about-hero__inner section section--page-width">
    <div class="about-hero__content">
      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="about-hero__text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.note != blank %}
        <p class="about-hero__note">{{ section.settings.note }}</p>
      {% endif %}
    </div>

    <div class="about-hero__image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '750, 1200, 1800', sizes: '100vw', alt: section.settings.image.alt | default: section.settings.heading, loading: 'eager' }}
      {% else %}
        <div class="about-hero__placeholder">Upload hero artwork</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .about-hero {
    background: var(--about-hero-bg, #eaf8fb);
    color: #143d63;
  }

  .about-hero__inner {
    position: relative;
    display: grid;
    min-height: 580px;
    align-items: center;
    overflow: hidden;
    padding-block: 58px;
  }

  .about-hero__content {
    position: relative;
    z-index: 1;
    width: min(52%, 700px);
    max-width: none;
    padding: clamp(28px, 4vw, 64px);
  }

  .about-hero h1,
  .about-hero__text,
  .about-hero__note {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .about-hero h1 {
    max-width: 620px;
    margin: 0;
    font-size: clamp(2.3rem, 3.6vw, 4rem);
    line-height: 0.98;
  }

  .about-hero__text {
    max-width: 560px;
    margin-top: 20px;
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    font-weight: 700;
    line-height: 1.38;
  }

  .about-hero__text p {
    margin: 0;
  }

  .about-hero__note {
    max-width: 360px;
    margin: 28px auto 0;
    color: #2d86b6;
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.25;
    text-align: center;
  }

  .about-hero__image {
    position: absolute;
    inset: 0;
  }

  .about-hero__image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(234 248 251 / 96%) 0%, rgb(234 248 251 / 74%) 37%, rgb(234 248 251 / 5%) 68%);
    content: '';
  }

  .about-hero__image img,
  .about-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-hero__placeholder {
    display: grid;
    place-items: center;
    color: #4c7285;
    background: linear-gradient(135deg, #d7f1fa, #fff);
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .about-hero__inner {
      min-height: 600px;
      align-items: start;
      padding-block: 36px;
    }

    .about-hero__image::after {
      background: linear-gradient(180deg, rgb(234 248 251 / 96%) 0%, rgb(234 248 251 / 78%) 46%, rgb(234 248 251 / 12%) 78%);
    }

    .about-hero__content {
      width: 100%;
      padding: 28px;
    }

    .about-hero__note {
      margin-left: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero artwork" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It All Started with ‘I Love It Here.’" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Little Lake Stories began with one very special birthday gift for my grandson Bennett - a one-of-a-kind book inspired by the lake memories, family adventures, and the joy of creating something meaningful that could be treasured for years to come.</p>" },
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Good stories keep the best memories close." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#eaf8fb" }
  ],
  "presets": [
    { "name": "About hero" }
  ]
}
{% endschema %}
