<section class="story-club-benefits" aria-labelledby="StoryClubBenefitsHeading-{{ section.id }}">
  <header class="story-club-benefits__header">
    <h2 id="StoryClubBenefitsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </header>

  <div class="story-club-benefits__grid">
    {% for block in section.blocks %}
      <article class="story-club-benefits__item" {{ block.shopify_attributes }}>
        <div class="story-club-benefits__icon" aria-hidden="true">
          {% if block.settings.icon_url != blank %}
            <img src="{{ block.settings.icon_url | escape }}" alt="" width="56" height="56" loading="eager">
          {% elsif forloop.index == 5 %}
            <span class="story-club-benefits__star"></span>
          {% endif %}
        </div>
        <h3>{{ block.settings.heading | escape }}</h3>
        <p>{{ block.settings.description | escape }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .story-club-benefits {
    padding: 48px 24px 56px;
    background: #fff;
    color: #143d63;
  }

  .story-club-benefits__header {
    width: min(100%, 1200px);
    margin: 0 auto 34px;
    text-align: center;
  }

  .story-club-benefits__header h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 42px;
    line-height: 1.08;
  }

  .story-club-benefits__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: min(100%, 1500px);
    margin: 0 auto;
  }

  .story-club-benefits__item {
    min-width: 0;
    padding: 0 24px;
    border-inline-end: 1px solid #e8edf0;
    text-align: center;
  }

  .story-club-benefits__item:last-child {
    border-inline-end: 0;
  }

  .story-club-benefits__icon {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    margin: 0 auto 14px;
  }

  .story-club-benefits__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .story-club-benefits__star {
    width: 49px;
    height: 49px;
    background: #f7bd4f;
    clip-path: polygon(50% 0, 62% 35%, 99% 36%, 70% 59%, 80% 96%, 50% 74%, 20% 96%, 30% 59%, 1% 36%, 38% 35%);
  }

  .story-club-benefits__item h3 {
    max-width: 18ch;
    margin: 0 auto;
    font-family: var(--font-heading--family);
    font-size: 21px;
    line-height: 1.12;
  }

  .story-club-benefits__item p {
    max-width: 24ch;
    margin: 16px auto 0;
    color: #475764;
    font-size: 16px;
    line-height: 1.35;
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .story-club-benefits__item {
      padding-inline: 14px;
    }

    .story-club-benefits__item h3 {
      font-size: 18px;
    }

    .story-club-benefits__item p {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .story-club-benefits {
      padding: 44px 18px 48px;
    }

    .story-club-benefits__header {
      margin-bottom: 24px;
    }

    .story-club-benefits__header h2 {
      font-size: 32px;
    }

    .story-club-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 14px;
    }

    .story-club-benefits__item {
      padding: 0 8px;
      border: 0;
    }

    .story-club-benefits__item:last-child {
      grid-column: 1 / -1;
      width: calc(50% - 7px);
      justify-self: center;
    }

    .story-club-benefits__icon {
      width: 48px;
      height: 48px;
      margin-bottom: 10px;
    }

    .story-club-benefits__star {
      width: 42px;
      height: 42px;
    }

    .story-club-benefits__item h3 {
      font-size: 18px;
    }

    .story-club-benefits__item p {
      margin-top: 9px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story Club benefits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Families Love the Little Lake Story Club" }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon_url", "label": "Icon image URL" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Build a lifelong collection" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A new story for every season and special moment." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story Club benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon_url": "https://cdn.shopify.com/s/files/1/0831/8376/3710/files/book.png", "heading": "Build a lifelong collection", "description": "A new story for every season and special moment." } },
        { "type": "benefit", "settings": { "icon_url": "https://cdn.shopify.com/s/files/1/0831/8376/3710/files/heart.png", "heading": "Create once, we do the rest", "description": "Complete their profile one time and we’ll handle the curation." } },
        { "type": "benefit", "settings": { "icon_url": "https://cdn.shopify.com/s/files/1/0831/8376/3710/files/cake.png", "heading": "A birthday story", "description": "During their birthday month, they’ll receive a special birthday adventure." } },
        { "type": "benefit", "settings": { "icon_url": "https://cdn.shopify.com/s/files/1/0831/8376/3710/files/gift.png", "heading": "Shipping included", "description": "No extra fees. Just stories and smiles delivered." } },
        { "type": "benefit", "settings": { "heading": "Meaningful & memorable", "description": "Stories that celebrate their childhood and the magic of lake life." } }
      ]
    }
  ]
}
{% endschema %}