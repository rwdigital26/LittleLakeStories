    { "type": "textarea", "id": "answer_4", "label": "Answer 4", "default": "Yes, every book is proudly printed in the USA." },
    { "type": "text", "id": "question_5", "label": "Question 5", "default": "Can I include a special message?" },
    { "type": "textarea", "id": "answer_5", "label": "Answer 5", "default": "Yes, add a meaningful note to make your keepsake even more personal." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Testimonials and FAQ" }
  ]
}
{% endschema %}
