      "name": "Choose your storybook",
      "blocks": [
        { "type": "format", "settings": { "badge_icon": "♥", "badge": "Our Signature Format", "heading": "The Classic Storybook", "dimensions": "8.5 x 8.5 in | Hardcover", "description": "A timeless square book made for little hands and treasured memories.", "button_label": "Explore This Book" } },
