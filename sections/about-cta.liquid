<section
  class="about-cta"
  {% if section.settings.background_image != blank %}
    style="--about-cta-image: url('{{ section.settings.background_image | image_url: width: 2400 }}'); --about-cta-bg: {{ section.settings.background_color }};"
  {% else %}
    style="--about-cta-bg: {{ section.settings.background_color }};"
  {% endif %}
>
  <div class="about-cta__content">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="about-cta__button">
        {{ section.settings.button_label }} <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .about-cta { position: relative; display: grid; min-height: 260px; overflow: hidden; place-items: center; padding: 36px 24px; background-color: var(--about-cta-bg, #eaf8fb); background-image: var(--about-cta-image); background-position: center; background-repeat: no-repeat; background-size: cover; color: #143d63; text-align: center; }
  .about-cta::before { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(234 248 251 / 58%), rgb(255 255 255 / 42%), rgb(234 248 251 / 58%)); content: ''; }
  .about-cta__content { position: relative; z-index: 1; max-width: 720px; }
  .about-cta h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.1rem, 3.7vw, 4rem); line-height: 1; }
  .about-cta p { max-width: 560px; margin: 12px auto 20px; font-family: Georgia, 'Times New Roman', serif; font-size: 1.06rem; font-weight: 700; line-height: 1.4; }
  .about-cta__button { display: inline-flex; min-height: 46px; align-items: center; gap: 9px; padding: 10px 22px; border-radius: 999px; color: #fff; background: #ed8b7b; font-family: Georgia, 'Times New Roman', serif; font-weight: 700; text-decoration: none; }
  .about-cta__button:hover { background: #d97869; }
  @media screen and (max-width: 749px) { .about-cta { min-height: 230px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "About call to action",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Lake background artwork" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to Create Your Story?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Turn your family's lake memories into a one-of-a-kind keepsake made with love." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create Your Story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#eaf8fb" }
  ],
  "presets": [{ "name": "About call to action" }]
}
{% endschema %}
