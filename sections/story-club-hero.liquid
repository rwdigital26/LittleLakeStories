{% liquid
  assign hero_image = section.settings.image
  assign hero_alt = section.settings.image.alt | default: 'A child and dog watching the sunset from a lakeside dock'
%}

<section class="story-club-hero" aria-labelledby="StoryClubHeading-{{ section.id }}">
  <div class="story-club-hero__media" aria-hidden="true">
    {% if hero_image != blank %}
      {{ hero_image | image_url: width: 2560 | image_tag: widths: '1200, 1600, 2000, 2400, 2560', sizes: '100vw', alt: hero_alt, loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <img
        src="https://cdn.shopify.com/s/files/1/0831/8376/3710/files/Child_and_Dog_at_Sunset_Lake.png?v=1791338391&width=2400"
        alt="{{ hero_alt | escape }}"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>
  <div class="story-club-hero__veil" aria-hidden="true"></div>

  {% if section.settings.ambient_note != blank %}
    <p class="story-club-hero__ambient-note">{{ section.settings.ambient_note | escape }}</p>
  {% endif %}

  <div class="story-club-hero__inner">
    <div class="story-club-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="story-club-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 id="StoryClubHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      <p class="story-club-hero__intro">{{ section.settings.subheading | escape }}</p>

      <ul class="story-club-hero__benefits">
        {% for index in (1..5) %}
          {% assign benefit_key = 'benefit_' | append: index %}
          {% assign benefit_text = section.settings[benefit_key] %}
          {% assign benefit_icons = 'book|heart|gift|cake|shipping' | split: '|' %}
          {% assign benefit_icon = benefit_icons[forloop.index0] | append: '.png' | file_url | append: '&width=96' %}
          {% if benefit_text != blank %}
            <li>
              <span class="story-club-hero__benefit-icon" aria-hidden="true">
                <img src="{{ benefit_icon }}" alt="" width="36" height="36" loading="lazy">
              </span>
              <span>{{ benefit_text | escape }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>

    </div>
  </div>
</section>

{% stylesheet %}
  .story-club-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 760px;
    align-items: center;
    overflow: hidden;
    background: #dff1f7;
    color: #143d63;
  }

  .story-club-hero__media {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .story-club-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 54%;
  }

  .story-club-hero__veil {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, rgb(255 255 255 / 86%) 0%, rgb(255 255 255 / 68%) 38%, rgb(255 255 255 / 0%) 74%);
    pointer-events: none;
  }

  .story-club-hero__inner {
    width: min(100%, 1440px);
    margin-inline: auto;
    padding: 64px 6vw 76px;
  }

  .story-club-hero__content {
    width: min(100%, 610px);
    text-shadow: 0 1px 12px rgb(255 255 255 / 45%);
  }

  .story-club-hero__eyebrow {
    margin: 0 0 12px;
    color: #0b5e97;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .story-club-hero h1 {
    max-width: 10ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 64px;
    font-weight: var(--font-heading--weight);
    line-height: 0.98;
  }

  .story-club-hero__intro {
    max-width: 34ch;
    margin: 18px 0 24px;
    font-family: var(--font-heading--family);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.25;
  }

  .story-club-hero__benefits {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story-club-hero__benefits li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
    font-weight: 600;
  }

  .story-club-hero__benefit-icon {
    display: grid;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    place-items: center;
  }

  .story-club-hero__benefit-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .story-club-hero__ambient-note {
    position: absolute;
    inset-block-start: 36px;
    inset-inline-end: max(5vw, calc((100vw - 1440px) / 2));
    max-width: 16ch;
    margin: 0;
    color: #0b5e97;
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-style: italic;
    font-weight: 700;
    text-align: center;
    text-shadow: 0 1px 12px rgb(255 255 255 / 70%);
  }

  @media screen and (max-width: 749px) {
    .story-club-hero {
      min-height: 940px;
      align-items: flex-start;
    }

    .story-club-hero__media img {
      object-position: 66% center;
    }

    .story-club-hero__veil {
      background: rgb(255 255 255 / 48%);
    }

    .story-club-hero__inner {
      padding: 92px 24px 48px;
    }

    .story-club-hero__content {
      width: 100%;
    }

    .story-club-hero h1 {
      max-width: 11ch;
      font-size: 42px;
    }

    .story-club-hero__intro {
      max-width: 32ch;
      font-size: 20px;
    }

    .story-club-hero__benefits li {
      font-size: 15px;
    }

    .story-club-hero__ambient-note {
      inset-block-start: 20px;
      inset-inline-end: 20px;
      max-width: 13ch;
      font-size: 15px;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story Club hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A new chapter every month" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little Lake Story Club" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A new personalized story starring your child, delivered every month." },
    { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Create their profile once" },
    { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Stories curated just for them" },
    { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "A new adventure every month" },
    { "type": "text", "id": "benefit_4", "label": "Benefit 4", "default": "Special birthday story" },
    { "type": "text", "id": "benefit_5", "label": "Benefit 5", "default": "Shipping included" }
  ],
  "presets": [
    { "name": "Story Club hero" }
  ]
}
{% endschema %}