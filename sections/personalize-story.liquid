<section class="personalize-story section section--page-width" style="--personalize-story-bg: {{ section.settings.background_color }};">
  <div class="personalize-story__copy">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>

    <a class="personalize-story__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{ section.settings.button_label }} <span aria-hidden="true">→</span>
    </a>
    <img
      class="personalize-story__tagline"
      src="{{ 'personalize-tagline.png' | asset_url }}"
      alt="Their memories. Their people. Their story. More than a personalized book. A keepsake for generations."
      width="746"
      height="80"
      loading="lazy"
    >
  </div>

  <div class="personalize-story__art">
    {% for block in section.blocks limit: 1 %}
      <article class="personalize-story__feature personalize-story__feature--primary" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 750px) 50vw, 90vw', alt: block.settings.heading, loading: 'lazy' }}
        {% else %}
          <img src="{{ 'personalize-feature-1.png' | asset_url }}" alt="{{ block.settings.heading }}" width="900" height="680" loading="lazy">
        {% endif %}
        <div class="personalize-story__feature-content">
          {% if block.settings.number != blank %}<span class="personalize-story__feature-number">{{ block.settings.number }}</span>{% endif %}
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
          {% if block.settings.description != blank %}<p>{{ block.settings.description }}</p>{% endif %}
        </div>
      </article>
    {% endfor %}

    <div class="personalize-story__features">
      {% for block in section.blocks offset: 1 %}
        <article class="personalize-story__feature" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '440, 660, 900', sizes: '(min-width: 750px) 30vw, 90vw', alt: block.settings.heading, loading: 'lazy' }}
          {% else %}
            {% assign feature_index = forloop.index | plus: 1 %}
            <img src="{{ 'personalize-feature-' | append: feature_index | append: '.png' | asset_url }}" alt="{{ block.settings.heading }}" width="440" height="333" loading="lazy">
          {% endif %}
          <div class="personalize-story__feature-content">
            {% if block.settings.number != blank %}<span class="personalize-story__feature-number">{{ block.settings.number }}</span>{% endif %}
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
            {% if block.settings.description != blank %}<p>{{ block.settings.description }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .personalize-story {
    display: grid;
    grid-template-areas:
      'copy primary'
      'features features';
    grid-template-columns: minmax(280px, 0.85fr) minmax(360px, 1.15fr);
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
    padding-block: 0 75px;
    padding-inline: clamp(24px, 5vw, 76px);
    border-radius: 12px;
    overflow: hidden;
    background-color: #eaf8fb !important;
    color: #143d63;
  }

  .personalize-story__copy {
    grid-area: copy;
    display: block !important;
    align-self: center;
    min-width: 0;
    max-width: 560px;
    visibility: visible !important;
    opacity: 1 !important;
    color: #143d63 !important;
  }

  .personalize-story h2,
  .personalize-story p,
  .personalize-story label,
  .personalize-story__button,
  .personalize-story__art-placeholder {
    font-family: Georgia, 'Times New Roman', serif;
  }

  .personalize-story h2 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3.15rem);
    line-height: 1;
  }

  .personalize-story__copy > p {
    max-width: 500px;
    margin: 14px 0 24px;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .personalize-story__proof {
    max-width: 560px;
    margin: 16px 0 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .personalize-story__tagline {
    display: block;
    width: min(100%, 500px);
    height: auto;
    margin-block-start: 20px;
  }

  .personalize-story__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 18px;
  }

  .personalize-story label {
    display: grid;
    gap: 7px;
    color: #143d63;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .personalize-story input,
  .personalize-story__select {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid #c6dce6;
    border-radius: 9px;
    color: #345d78;
    background: #fff;
    font: inherit;
    font-size: 1rem;
  }

  .personalize-story__select i {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-inline-end: 9px;
    border-radius: 50%;
    color: #527791;
    background: #f2d38b;
    font-style: normal;
    text-align: center;
  }

  .personalize-story__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    margin-block-start: 18px;
    padding-inline: 30px;
    border-radius: 999px;
    color: #fff;
    background: #2d86b6;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .personalize-story__button span {
    margin-inline-start: 8px;
    font-size: 1.2em;
  }

  .personalize-story__button:hover {
    background: #143d63;
  }

  .personalize-story__art {
    display: contents;
  }

  .personalize-story__features {
    grid-area: features;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .personalize-story__feature {
    position: relative;
    display: grid;
    min-width: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 3px 12px rgb(20 61 99 / 8%);
  }

  .personalize-story__feature > img {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 439 / 333;
    object-fit: cover;
  }

  .personalize-story__feature::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(255 255 255 / 88%) 0%, rgb(255 255 255 / 66%) 48%, rgb(255 255 255 / 5%) 100%);
    content: "";
    pointer-events: none;
  }

  .personalize-story__feature-content {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    align-self: start;
    max-width: 68%;
    padding: 20px;
    color: #143d63;
  }

  .personalize-story__feature-number {
    display: grid;
    width: 42px;
    aspect-ratio: 1;
    place-items: center;
    margin-bottom: 12px;
    border-radius: 50%;
    color: #fff;
    background: rgb(45 134 182 / 82%);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .personalize-story__feature-content h3 {
    margin: 0 0 8px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.15rem, 1.65vw, 1.75rem);
    line-height: 1.05;
  }

  .personalize-story__feature-content p {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(0.77rem, 1vw, 1rem);
    font-weight: 700;
    line-height: 1.28;
  }

  .personalize-story__feature--primary {
    grid-area: primary;
    align-self: stretch;
  }

  .personalize-story__feature--primary > img {
    height: 100%;
    min-height: 310px;
    aspect-ratio: auto;
  }

  .personalize-story__feature--primary .personalize-story__feature-content {
    max-width: 49%;
    padding: 24px 20px;
  }

  .personalize-story__feature--primary .personalize-story__feature-number {
    width: 38px;
    margin-bottom: 9px;
    font-size: 1.2rem;
  }

  .personalize-story__feature--primary .personalize-story__feature-content h3 {
    margin-bottom: 7px;
    font-size: clamp(1.35rem, 2.05vw, 2rem);
    line-height: 1.02;
  }

  .personalize-story__feature--primary .personalize-story__feature-content p {
    font-size: clamp(0.8rem, 1.05vw, 1.02rem);
    line-height: 1.25;
  }

  .personalize-story__art-placeholder {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 28px;
    height: 100%;
    min-height: 360px;
    padding: 32px;
    color: #143d63;
    background: linear-gradient(135deg, #d8f1fa, #fff);
  }

  .personalize-story__book {
    display: grid;
    place-items: center;
    aspect-ratio: 0.78;
    padding: 22px;
    color: #fff;
    background: linear-gradient(145deg, #4f9bc3, #143d63);
    box-shadow: 14px 16px 0 rgb(20 61 99 / 12%);
    font-size: clamp(1.4rem, 2.5vw, 2.7rem);
    font-weight: 700;
    text-align: center;
  }

  .personalize-story__art-placeholder > span {
    align-self: center;
    font-size: clamp(1.5rem, 2vw, 2.4rem);
    font-style: italic;
    line-height: 1.3;
  }

  @media screen and (max-width: 599px) {
    .personalize-story {
      grid-template-areas:
        'copy'
        'primary'
        'features';
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 48px 75px;
      border-radius: 0;
    }

    .personalize-story__fields {
      grid-template-columns: 1fr;
    }

    .personalize-story__features {
      grid-template-columns: 1fr;
    }

    .personalize-story__feature--primary > img {
      min-height: 0;
      height: auto;
      aspect-ratio: 439 / 333;
    }

    .personalize-story__feature-content {
      max-width: 72%;
    }

    .personalize-story__feature--primary .personalize-story__feature-content {
      max-width: 58%;
    }

    .personalize-story__art-placeholder {
      min-height: 280px;
      padding: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Personalize your story",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "1" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A Story Written Just for Them" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "We write every story from scratch using your answers, memories, and ideas." }
      ]
    }
  ],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Artwork" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make It Uniquely Theirs" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Personalize the details to create a one-of-a-kind adventure they'll treasure forever." },
    { "type": "text", "id": "name_label", "label": "Name field label", "default": "Child's Name" },
    { "type": "text", "id": "name_value", "label": "Name field value", "default": "Emma" },
    { "type": "text", "id": "hair_label", "label": "Hair field label", "default": "Hair Color" },
    { "type": "text", "id": "hair_value", "label": "Hair field value", "default": "Blonde" },
    { "type": "text", "id": "activity_label", "label": "Activity field label", "default": "Favorite Activity" },
    { "type": "text", "id": "activity_value", "label": "Activity field value", "default": "Boating" },
    { "type": "text", "id": "companions_label", "label": "Companions field label", "default": "Companions" },
    { "type": "text", "id": "companions_value", "label": "Companions field value", "default": "Grandma & Grandpa" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Preview My Book" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "placeholder_book_title", "label": "Fallback book title", "default": "Emma's Lake Geneva Adventure" },
    { "type": "text", "id": "placeholder_note", "label": "Fallback artwork note", "default": "Every child has a story waiting on the lake." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#eaf8fb" }
  ],
  "presets": [
    {
      "name": "Personalize your story",
      "blocks": [
        { "type": "feature", "settings": { "number": "1", "heading": "A Story Written Just for Them", "description": "We write every story from scratch using your answers, memories, and ideas." } },
        { "type": "feature", "settings": { "number": "2", "heading": "Their Favorite People, Brought to Life", "description": "Upload photos of your child, family members, and beloved pets." } },
        { "type": "feature", "settings": { "number": "3", "heading": "Real Places. Magical Adventures.", "description": "We use your memories to recreate meaningful places in beautiful illustrations." } },
        { "type": "feature", "settings": { "number": "4", "heading": "It’s the Little Details That Matter", "description": "The silly nickname, favorite ice cream, and family traditions make every story feel like home." } }
      ]
    }
  ]
}
{% endschema %}
